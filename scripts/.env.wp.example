# =====================================================================
#  Credenciais do wp-post.sh — COPIE para scripts/.env.wp e preencha.
#  scripts/.env.wp é git-ignored e NÃO deve ir para o repo nem sincronizar.
# =====================================================================

# URL base do site (sem barra no fim)
WP_BASE_URL=https://mdotti.com

# Login do usuário WordPress (admin)
WP_USER=danilo

# Application Password gerado em:
#   wp-admin > Usuários > Perfil > "Application Passwords"
# Cole exatamente como o WordPress mostrou, ENTRE ASPAS (tem espaços):
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
